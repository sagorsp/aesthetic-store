APP_NAME="Aesthetic Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aestheticstore.bd
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aestheticstore
DB_USERNAME=aestheticstore
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@aestheticstore.bd"
MAIL_FROM_NAME="${APP_NAME}"

STORE_DOMAIN=aestheticstore.bd
STORE_PHONE=01550720798
STORE_EMAIL=support@aestheticstore.bd
STORE_CURRENCY=BDT
STORE_CURRENCY_SYMBOL=৳
ADMIN_EMAIL=shagurhd@gmail.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

DHAKA_DELIVERY_CHARGE=80
OUTSIDE_DHAKA_DELIVERY_CHARGE=130

BKASH_ENABLED=false
BKASH_SANDBOX=true
BKASH_BASE_URL_SANDBOX=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_BASE_URL_LIVE=https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://aestheticstore.bd/payment/bkash/callback

# SMS gateway (generic adapter; map request fields in SmsService if your provider differs)
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
